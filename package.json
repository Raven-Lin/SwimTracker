{
  "name": "swimtracker",
  "version": "2.0.0",
  "description": "Offline squad analytics for swim coaches. A static page — no server, no install.",
  "author": "Joanne Lou",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "npm run test:unit && npm run test:py && npm run test:e2e",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:py": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "fixture": "node tools/make-fixture.mjs 150 tests/fixtures/squad-150.csv",
    "screenshots": "node tools/screenshot.mjs http",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
